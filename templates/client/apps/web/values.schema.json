{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replicas",
    "version",
    "color",
    "image"
  ],
  "properties": {
    "replicas": {
      "type": "integer",
      "minimum": 2,
      "maximum": 20,
      "description": "At least 2: the PDB lets one pod go during a drain."
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "image": {
      "type": "string",
      "minLength": 1
    }
  }
}
